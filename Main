/*
  Burn wire release timer
  Board: Arduino Nano   Clock: DS3231   Library: RTClib (Adafruit)

  Wiring (matches the diagram):
    DS3231 VCC -> 5V, GND -> GND, SDA -> A4, SCL -> A5, SQW -> D2
    Arm switch (reed switch or push button) between D3 and GND
    D9 -> 220 ohm -> MOSFET gate (10k pull-down from gate to GND)
    MOSFET drain -> nichrome wire -> burn battery +, source -> common GND
    Built-in LED (D13) shows status

  How it works:
    1. Hold the magnet on the reed switch (or press the button) and power the board.
    2. Let go. The board starts the countdown and goes to sleep.
    3. The DS3231 wakes the board on a schedule (daily in real mode).
       Each wake it checks:
         - Is the countdown over?  -> burn
         - Is the battery low?     -> burn early
    4. After a burn it records that in EEPROM and sleeps for good.

  Hold the magnet for 8+ seconds at power-up, then let go = short test burn
  (the board is NOT armed afterwards; power cycle to arm).

  To start fresh on the bench, always hold the switch while powering up.

  SAFETY: nichrome gets very hot. Adult supervision, non-flammable surface.
*/

#include <Wire.h>
#include <RTClib.h>
#include <EEPROM.h>
#include <avr/sleep.h>

// ---------- Settings ----------
#define DEMO_MODE 1   // 1 = fast desk test, 0 = real deployment

#if DEMO_MODE
  #define DEPLOY_SECONDS 60UL            // burn 1 minute after arming
  #define WAKE_MODE      DS3231_A1_PerSecond  // wake every second
  #define BURN_MS        2000            // wire on for 2 seconds
  #define BURN_PULSES    1
#else
  #define DEPLOY_SECONDS (90UL * 24UL * 3600UL)  // about 3 months
  #define WAKE_MODE      DS3231_A1_Hour          // wake once a day
  #define BURN_MS        4000
  #define BURN_PULSES    2               // second pulse is a backup
#endif

#define BURN_GAP_MS    3000     // pause between pulses
#define LOW_BATT_MV    2600     // fire early below this (millivolts)
#define TEST_HOLD_MS   8000     // hold switch this long for test burn

// ---------- Pins ----------
#define ALARM_PIN 2   // DS3231 SQW/INT (must be pin 2 or 3 for interrupts)
#define ARM_PIN   3   // reed switch or button to GND
#define BURN_PIN  9   // MOSFET gate (through 220 ohm)
#define LED_PIN   LED_BUILTIN

#if DEMO_MODE
  #define LOG(x) Serial.println(x)
#else
  #define LOG(x)
#endif

RTC_DS3231 rtc;

// Saved in EEPROM so a reset doesn't lose the countdown
struct State {
  uint32_t magic;
  uint32_t target;   // unix time to burn
  uint8_t  fired;
};
State st;
const uint32_t MAGIC = 0xB0F10A7UL;

// ---------- Helpers ----------
bool magnetPresent() {
  return digitalRead(ARM_PIN) == LOW;
}

void blink(uint8_t times, uint16_t ms) {
  for (uint8_t i = 0; i < times; i++) {
    digitalWrite(LED_PIN, HIGH);
    delay(ms);
    digitalWrite(LED_PIN, LOW);
    delay(ms);
  }
}

void saveState() {
  EEPROM.put(0, st);
}

// Read the supply voltage using the chip's internal reference
uint16_t readVccMv() {
  ADMUX = _BV(REFS0) | _BV(MUX3) | _BV(MUX2) | _BV(MUX1);
  delay(2);
  ADCSRA |= _BV(ADSC);
  while (bit_is_set(ADCSRA, ADSC)) {}
  uint32_t result = ADC;
  return (uint16_t)(1125300UL / result);
}

void setWakeAlarm() {
  rtc.clearAlarm(1);
  rtc.setAlarm1(rtc.now() + TimeSpan(5), WAKE_MODE);
}

void wakeISR() {}   // empty on purpose, it just wakes the chip

void sleepUntilAlarm() {
#if DEMO_MODE
  Serial.flush();
#endif
  ADCSRA &= ~_BV(ADEN);                  // ADC off while asleep
  set_sleep_mode(SLEEP_MODE_PWR_DOWN);
  noInterrupts();
  attachInterrupt(digitalPinToInterrupt(ALARM_PIN), wakeISR, LOW);
  sleep_enable();
  interrupts();
  sleep_cpu();                           // sleeps here
  sleep_disable();
  detachInterrupt(digitalPinToInterrupt(ALARM_PIN));
  ADCSRA |= _BV(ADEN);
}

void sleepForever() {
  digitalWrite(BURN_PIN, LOW);
  ADCSRA &= ~_BV(ADEN);
  set_sleep_mode(SLEEP_MODE_PWR_DOWN);
  noInterrupts();
  sleep_enable();
  sleep_cpu();                           // only a reset wakes this
  while (true) {}
}

void fireRelease() {
  LOG(F("BURN"));
  for (uint8_t i = 0; i < BURN_PULSES; i++) {
    digitalWrite(BURN_PIN, HIGH);
    delay(BURN_MS);
    digitalWrite(BURN_PIN, LOW);
    if (i < BURN_PULSES - 1) delay(BURN_GAP_MS);
  }
}

// ---------- Main ----------
void setup() {
  pinMode(BURN_PIN, OUTPUT);
  digitalWrite(BURN_PIN, LOW);           // make sure the wire is off first
  pinMode(LED_PIN, OUTPUT);
  pinMode(ARM_PIN, INPUT_PULLUP);
  pinMode(ALARM_PIN, INPUT_PULLUP);

#if DEMO_MODE
  Serial.begin(9600);
#endif

  if (!rtc.begin()) {
    while (true) blink(1, 50);           // fast blinking = clock not found
  }
  if (rtc.lostPower()) {
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
    LOG(F("Clock was reset to compile time"));
  }
  rtc.disable32K();
  rtc.writeSqwPinMode(DS3231_OFF);       // SQW pin = alarm interrupt
  rtc.disableAlarm(2);
  rtc.clearAlarm(2);

  EEPROM.get(0, st);
  bool resumable = (st.magic == MAGIC) && (st.fired == 0);

  // Nothing saved and no switch pressed: wait to be armed
  if (!magnetPresent() && !resumable) {
    LOG(F("Waiting for arm switch"));
    while (!magnetPresent()) delay(50);
  }

  if (magnetPresent()) {
    unsigned long t0 = millis();
    while (magnetPresent()) delay(20);   // wait for release

    if (millis() - t0 >= TEST_HOLD_MS) {
      LOG(F("Test burn"));
      digitalWrite(LED_PIN, HIGH);
      digitalWrite(BURN_PIN, HIGH);
      delay(1500);
      digitalWrite(BURN_PIN, LOW);
      digitalWrite(LED_PIN, LOW);
      sleepForever();
    }

    st.magic  = MAGIC;
    st.target = rtc.now().unixtime() + DEPLOY_SECONDS;
    st.fired  = 0;
    saveState();
    blink(3, 150);                       // 3 blinks = armed
    LOG(F("Armed"));
  } else {
    LOG(F("Resuming saved countdown"));
  }

  setWakeAlarm();
}

void loop() {
  sleepUntilAlarm();
  rtc.clearAlarm(1);

  uint32_t nowTs = rtc.now().unixtime();
  uint16_t mv = readVccMv();
  bool timeUp  = nowTs >= st.target;
  bool lowBatt = mv < LOW_BATT_MV;

#if DEMO_MODE
  Serial.print(F("Seconds left: "));
  Serial.print((long)st.target - (long)nowTs);
  Serial.print(F("  Vcc mV: "));
  Serial.println(mv);
#endif

  if (timeUp || lowBatt) {
    fireRelease();
    st.fired = 1;
    saveState();
    sleepForever();
  }
}
